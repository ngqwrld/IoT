    {
      "id": 6,
      "type": "table",
      "title": "Agregaciones diarias de ${magnitud} – ${aula} (última semana)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "import \"timezone\"\noption location = timezone.fixed(offset: -5h)   // Colombia (UTC-5)\nbase = from(bucket: \"iot_aulas\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"${magnitud}\" and r.aula == \"${aula}\")\n  |> group()\n  |> sort(columns: [\"_time\"])\npromedio = base |> aggregateWindow(every: 1d, fn: mean, createEmpty: false, timeSrc: \"_start\") |> set(key: \"estadistico\", value: \"Promedio\")\nmaximo = base |> aggregateWindow(every: 1d, fn: max, createEmpty: false, timeSrc: \"_start\") |> set(key: \"estadistico\", value: \"Maximo\")\nminimo = base |> aggregateWindow(every: 1d, fn: min, createEmpty: false, timeSrc: \"_start\") |> set(key: \"estadistico\", value: \"Minimo\")\nunion(tables: [promedio, maximo, minimo])\n  |> keep(columns: [\"_time\", \"estadistico\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"estadistico\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Maximo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c62828"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Minimo"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2f6db5"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "_time": "Día",
              "Promedio": "Promedio",
              "Maximo": "Máximo",
              "Minimo": "Mínimo"
            },
            "indexByName": {
              "_time": 0,
              "Promedio": 1,
              "Maximo": 2,
              "Minimo": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
