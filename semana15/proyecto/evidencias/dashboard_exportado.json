  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Estado actual – ${aula}",
      "description": "Qué tan cerca está la temperatura actual del umbral dinámico: 0 % = temperatura media del aula, 100 % = umbral (μ + 2σ). Verde: normal (por debajo de μ + 1σ, 50 %). Amarillo: precaución (entre μ + 1σ y μ + 2σ). Rojo: alerta, supera el umbral.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "import \"math\"\nu = from(bucket: \"iot_aulas\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"umbral\" and r.aula == \"${aula}\" and (r._field == \"umbral_alto\" or r._field == \"media\"))\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> findRecord(fn: (key) => true, idx: 0)\nfrom(bucket: \"iot_aulas\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperatura\" and r.aula == \"${aula}\")\n  |> group()\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: (r._value - u.media) / math.mMax(x: u.umbral_alto - u.media, y: 0.4) * 100.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": -50,
          "max": 150,
          "displayName": "Nivel hacia el umbral",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Temperatura actual vs. umbral dinámico",
      "description": "Umbral dinámico = media + 2·desviación estándar del histórico (calculado por alerta_umbral_dinamico.py).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "from(bucket: \"iot_aulas\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperatura\" and r.aula == \"${aula}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "from(bucket: \"iot_aulas\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"umbral\" and r._field == \"umbral_alto\" and r.aula == \"${aula}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
