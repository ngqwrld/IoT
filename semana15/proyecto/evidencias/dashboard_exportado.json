      "type": "timeseries",
      "title": "Comparativa de temperatura: Aula A vs. Aula B",
      "description": "Aula A: NodeMCU real vía Adafruit IO. Aula B: datos simulados (simulador_aula_b.py).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "from(bucket: \"iot_aulas\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperatura\")\n  |> group(columns: [\"aula\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: ${intervalo}, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"aula\"])"
        }
