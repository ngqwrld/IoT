      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_iot"
          },
          "query": "from(bucket: \"iot_aulas\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"alertas\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"aula\", \"temperatura\", \"umbral\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 10)"
        }
      ],
