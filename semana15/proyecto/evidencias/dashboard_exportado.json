    {
      "id": 3,
      "type": "table",
      "title": "Últimas alertas disparadas (24 h)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_iot"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
